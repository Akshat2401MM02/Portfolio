# Paste your EXISTING Atlas cluster's connection string here.
# Just change the database name in the path (e.g. /portfolioDB) — do NOT create a new cluster.
MONGODB_URI=mongodb+srv://<username>:<password>@<your-existing-cluster>.mongodb.net/portfolioDB?retryWrites=true&w=majority

PORT=5000

# Comma-separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173
